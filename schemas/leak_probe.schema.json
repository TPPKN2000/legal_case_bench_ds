{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-le-bench:leak_probe",
  "title": "leak_probe",
  "type": "object",
  "properties": {
    "probe_id": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "precedent",
        "query",
        "passage"
      ]
    },
    "target_id": {
      "type": "string"
    },
    "variant": {
      "type": "string",
      "enum": [
        "original",
        "anonymized_citation",
        "anonymized_entities",
        "no_citation_context",
        "citing_sentence_removed"
      ]
    },
    "text": {
      "type": "string"
    },
    "mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "original": {
            "type": "string"
          },
          "replacement": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "PRECEDENT_NO",
              "JUDGMENT_NO",
              "COURT",
              "PERSON",
              "PLACE",
              "DATE",
              "LAW_REF"
            ]
          }
        },
        "required": [
          "original",
          "replacement",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "generated_by": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "rule",
            "llm",
            "manual"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "$ref": "#/$defs/date_or_null"
        }
      },
      "required": [
        "method"
      ],
      "additionalProperties": false
    },
    "direct_quote_flag": {
      "type": "boolean"
    },
    "expected_invariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "phải giữ nguyên sau ẩn danh: cấu trúc lập luận, điều luật"
    }
  },
  "required": [
    "probe_id",
    "target_type",
    "target_id",
    "variant",
    "text",
    "mapping",
    "generated_by"
  ],
  "additionalProperties": false,
  "description": "Biến thể ẩn danh để kiểm tra ghi nhớ/rò rỉ (Arvin §3; LePaRD App. C)",
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}