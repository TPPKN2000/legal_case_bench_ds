{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:an-le-bench:judgments",
  "title": "judgments",
  "type": "object",
  "properties": {
    "judgment_id": {
      "type": "string",
      "minLength": 3
    },
    "meta": {
      "type": "object",
      "properties": {
        "so_hieu": {
          "type": "string"
        },
        "ky_hieu": {
          "type": "string"
        },
        "nam": {
          "type": "integer"
        },
        "ngay_xu": {
          "$ref": "#/$defs/date"
        },
        "toa_an": {
          "type": "string"
        },
        "cap_toa": {
          "type": "string",
          "enum": [
            "district",
            "provincial",
            "high",
            "supreme"
          ]
        },
        "cap_xet_xu": {
          "type": "string",
          "enum": [
            "first_instance",
            "appeal",
            "cassation",
            "reopening"
          ]
        },
        "linh_vuc": {
          "$ref": "#/$defs/linh_vuc"
        },
        "trich_yeu": {
          "type": "string"
        }
      },
      "required": [
        "so_hieu",
        "ky_hieu",
        "nam",
        "ngay_xu",
        "toa_an",
        "cap_xet_xu",
        "linh_vuc"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "header",
              "plaintiff_statement",
              "defendant_statement",
              "verification_record",
              "prosecutor_opinion",
              "court_reasoning",
              "decision",
              "other"
            ]
          },
          "span": {
            "oneOf": [
              {
                "$ref": "#/$defs/span"
              },
              {
                "type": "null"
              }
            ]
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "span": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/span"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "paragraph": {
            "type": "string"
          },
          "question": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "question"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F\\d+$"
          },
          "sent": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "plaintiff_alleged",
              "defendant_alleged",
              "undisputed",
              "court_found"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted_by_court",
              "rejected_by_court",
              "not_addressed"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_section": {
            "type": "string"
          },
          "span": {
            "oneOf": [
              {
                "$ref": "#/$defs/span"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "sent",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "citations_law": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "prov_id": {
            "oneOf": [
              {
                "$ref": "#/$defs/prov_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "decision_basis",
              "procedure",
              "fee",
              "other"
            ]
          },
          "paragraph": {
            "type": [
              "string",
              "null"
            ]
          },
          "span": {
            "oneOf": [
              {
                "$ref": "#/$defs/span"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ref",
          "prov_id",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "citations_precedent": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "precedent_id": {
            "$ref": "#/$defs/precedent_id"
          },
          "usage": {
            "type": "string",
            "enum": [
              "applied",
              "considered_not_applied"
            ]
          },
          "paragraph": {
            "type": "string"
          },
          "citing_sentence_span": {
            "oneOf": [
              {
                "$ref": "#/$defs/span"
              },
              {
                "type": "null"
              }
            ]
          },
          "similar_facts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "matched_holding": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason_if_not_applied": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "precedent_id",
          "usage",
          "paragraph"
        ],
        "additionalProperties": false
      }
    },
    "precedent_usage": {
      "type": "string",
      "enum": [
        "none",
        "applied",
        "considered_not_applied"
      ]
    },
    "decision_text_span": {
      "oneOf": [
        {
          "$ref": "#/$defs/span"
        },
        {
          "type": "null"
        }
      ],
      "description": "chỉ giữ vị trí phần Quyết định làm nguồn; KHÔNG có nhãn kết quả (ngoài phạm vi: không dự đoán phán quyết)"
    },
    "role_in_benchmark": {
      "type": "string",
      "enum": [
        "provenance_only",
        "external_validation",
        "hard_negative_source",
        "non_citing_reference"
      ]
    },
    "pii_policy": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "ocr_fixed": {
          "type": "boolean"
        },
        "font_fix": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "ocr_fixed"
      ],
      "additionalProperties": true
    },
    "curation": {
      "$ref": "#/$defs/curation"
    }
  },
  "required": [
    "judgment_id",
    "meta",
    "sections",
    "issues",
    "facts",
    "citations_law",
    "citations_precedent",
    "precedent_usage",
    "role_in_benchmark",
    "pii_policy",
    "quality",
    "curation"
  ],
  "additionalProperties": false,
  "description": "Bản án: nguồn gốc truy vấn / kiểm chứng ngoại; không phải đối tượng dự đoán",
  "$defs": {
    "span": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[start,end) ký tự trong text_clean của tài liệu"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "precedent_id": {
      "type": "string",
      "pattern": "^AL-\\d{2,3}/\\d{4}$",
      "description": "vd AL-53/2022 (số hiệu án lệ bỏ hậu tố /AL)"
    },
    "prov_id": {
      "type": "string",
      "pattern": "^[^#\\s]+#[A-Za-z0-9.]+$",
      "description": "<số hiệu văn bản>#<d=điều|k=khoản|c=điểm|m=mục>, vd 52/2014/QH13#d5.k2.c"
    },
    "linh_vuc": {
      "type": "string",
      "enum": [
        "hon_nhan_gia_dinh",
        "dan_su",
        "hinh_su",
        "kinh_doanh_thuong_mai",
        "lao_dong",
        "hanh_chinh",
        "to_tung",
        "khac"
      ]
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "by"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft_unreviewed",
            "expert_reviewed",
            "adjudicated"
          ]
        },
        "by": {
          "type": "string"
        },
        "date": {
          "$ref": "#/$defs/date_or_null"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "PRECEDENT_NO",
            "JUDGMENT_NO",
            "LAW_REF",
            "COURT",
            "DATE",
            "MONEY",
            "PARTY_ROLE",
            "LEGAL_ACT",
            "RELIEF"
          ]
        },
        "text": {
          "type": "string"
        },
        "norm": {
          "type": [
            "string",
            "null"
          ],
          "description": "dạng chuẩn hoá, vd prov_id hoặc precedent_id"
        },
        "span": {
          "oneOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "date_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}